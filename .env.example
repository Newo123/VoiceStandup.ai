# AI — OpenRouter (Speech-to-Text + LLM)
# Оба сервиса используют один API-ключ OpenRouter, но для гибкости
# можно задать разные ключи для STT и LLM.
LLM_API_KEY=sk-or-v1-change_me
STT_MODEL=openai/whisper-large-v3-turbo
STT_TIMEOUT=60s

LLM_MODEL=google/gemini-2.5-flash
# Альтернативы для LLM:
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=deepseek/deepseek-chat
LLM_TIMEOUT=30s

# PostgreSQL
POSTGRES_USER=voice_standup
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_standup

# Используется приложением при локальном запуске.
# Значения должны соответствовать переменным POSTGRES_* выше.
DATABASE_URL=postgresql://voice_standup:change_me@localhost:5432/voice_standup?sslmode=disable
POSTGRES_CONNECT_TIMEOUT=5s

# Redis
# Внутри Docker-сети Redis доступен по имени сервиса redis на порту 6379.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5s

# Logger
LOGGER_LEVEL=debug

# Telegram
BOT_TOKEN=change_me

# REST API для Telegram Mini App
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=5s
TELEGRAM_AUTH_MAX_AGE=5m
