# AI 1 — распознавание речи (Speech-to-Text)
STT_PROVIDER=provider_name
STT_ENDPOINT=https://api.example.com/v1
STT_API_KEY=change_me
STT_MODEL=model_name

# AI 2 — структурирование стендапа (LLM)
LLM_PROVIDER=provider_name
LLM_ENDPOINT=https://api.example.com/v1
LLM_API_KEY=change_me
LLM_MODEL=model_name

# PostgreSQL
POSTGRES_USER=voice_standup
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_standup

# Используется приложением при локальном запуске.
# Значения должны соответствовать переменным POSTGRES_* выше.
DATABASE_URL=postgresql://voice_standup:change_me@localhost:5432/voice_standup?sslmode=disable
POSTGRES_CONNECT_TIMEOUT=5s

# Redis
# Внутри Docker-сети Redis доступен по имени сервиса redis на порту 6379.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5s

# Logger
LOGGER_LEVEL=debug

# Telegram
BOT_TOKEN=change_me
